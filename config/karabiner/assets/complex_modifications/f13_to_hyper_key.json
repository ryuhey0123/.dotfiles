{
  "title": "F13 → Hyper Key (⌃⌥⇧⌘)",
  "rules": [
    {
      "description": "F13をHyper keyに置き換える",
      "manipulators": [
        {
          "from": {
            "key_code": "f13",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "key_code": "left_shift",
              "modifiers": ["left_command", "left_control", "left_option"]
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
