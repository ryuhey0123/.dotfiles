{
  "profiles": [
    {
      "name": "Default profile",
      "selected": true,
      "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" },
      "devices": [
        {
          "identifiers": {
            "is_keyboard": true,
            "is_pointing_device": true,
            "vendor_id": 2007
          },
          "ignore": false
        }
      ],
      "simple_modifications": [
        {
          "from": { "consumer_key_code": "menu" },
          "to": [{ "key_code": "f13" }]
        }
      ],
      "complex_modifications": {
        "rules": [
          {
            "description": "Caps lockをControlキーに置き換える(仮想環境のみ)",
            "manipulators": [
              {
                "conditions": [
                  {
                    "bundle_identifiers": [
                      "^com\\.parallels\\.desktop\\.console$",
                      "^com\\.vmware\\.fusion$"
                    ],
                    "type": "frontmost_application_if"
                  }
                ],
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [{ "key_code": "left_control" }],
                "type": "basic"
              }
            ]
          },
          {
            "description": "Caps lockをControlキーに置き換える(ただし仮想環境は除く)",
            "manipulators": [
              {
                "conditions": [
                  {
                    "bundle_identifiers": [
                      "^com\\.parallels\\.desktop\\.console$",
                      "^com\\.vmware\\.fusion$"
                    ],
                    "type": "frontmost_application_unless"
                  }
                ],
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [{ "key_code": "left_control" }],
                "type": "basic"
              }
            ]
          },
          {
            "description": "F13をHyper keyに置き換える",
            "manipulators": [
              {
                "from": {
                  "key_code": "f13",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [
                  {
                    "key_code": "left_shift",
                    "modifiers": ["left_command", "left_control", "left_option"]
                  }
                ],
                "type": "basic"
              }
            ]
          },
          {
            "description": "コマンドキーを単体で押したときに、英数・かなキーを送信する + Parallels Windows",
            "manipulators": [
              {
                "conditions": [
                  {
                    "bundle_identifiers": [
                      "^com\\.parallels\\.desktop$",
                      "^com\\.parallels\\.vm$",
                      "^com\\.parallels\\.desktop\\.console$",
                      "^com\\.parallels\\.winapp\\."
                    ],
                    "type": "frontmost_application_unless"
                  }
                ],
                "from": {
                  "key_code": "left_command",
                  "modifiers": { "optional": ["any"] }
                },
                "parameters": { "basic.to_if_held_down_threshold_milliseconds": 100 },
                "to": [
                  {
                    "key_code": "left_command",
                    "lazy": true
                  }
                ],
                "to_if_alone": [{ "key_code": "japanese_eisuu" }],
                "to_if_held_down": [{ "key_code": "left_command" }],
                "type": "basic"
              },
              {
                "conditions": [
                  {
                    "bundle_identifiers": [
                      "^com\\.parallels\\.desktop$",
                      "^com\\.parallels\\.vm$",
                      "^com\\.parallels\\.desktop\\.console$",
                      "^com\\.parallels\\.winapp\\."
                    ],
                    "type": "frontmost_application_unless"
                  }
                ],
                "from": {
                  "key_code": "right_command",
                  "modifiers": { "optional": ["any"] }
                },
                "parameters": { "basic.to_if_held_down_threshold_milliseconds": 100 },
                "to": [
                  {
                    "key_code": "right_command",
                    "lazy": true
                  }
                ],
                "to_if_alone": [{ "key_code": "japanese_kana" }],
                "to_if_held_down": [{ "key_code": "right_command" }],
                "type": "basic"
              },
              {
                "conditions": [
                  {
                    "bundle_identifiers": [
                      "^com\\.parallels\\.desktop$",
                      "^com\\.parallels\\.vm$",
                      "^com\\.parallels\\.desktop\\.console$",
                      "^com\\.parallels\\.winapp\\."
                    ],
                    "type": "frontmost_application_if"
                  }
                ],
                "from": {
                  "key_code": "left_command",
                  "modifiers": { "optional": ["any"] }
                },
                "parameters": { "basic.to_if_held_down_threshold_milliseconds": 100 },
                "to": [
                  {
                    "key_code": "left_control",
                    "lazy": true
                  }
                ],
                "to_if_alone": [
                  {
                    "key_code": "f9",
                    "modifiers": ["left_control", "left_shift"]
                  }
                ],
                "to_if_held_down": [{ "key_code": "left_control" }],
                "type": "basic"
              },
              {
                "conditions": [
                  {
                    "bundle_identifiers": [
                      "^com\\.parallels\\.desktop$",
                      "^com\\.parallels\\.vm$",
                      "^com\\.parallels\\.desktop\\.console$",
                      "^com\\.parallels\\.winapp\\."
                    ],
                    "type": "frontmost_application_if"
                  }
                ],
                "from": {
                  "key_code": "right_command",
                  "modifiers": { "optional": ["any"] }
                },
                "parameters": { "basic.to_if_held_down_threshold_milliseconds": 100 },
                "to": [
                  {
                    "key_code": "right_control",
                    "lazy": true
                  }
                ],
                "to_if_alone": [
                  {
                    "key_code": "f10",
                    "modifiers": ["left_control", "left_shift"]
                  }
                ],
                "to_if_held_down": [{ "key_code": "right_control" }],
                "type": "basic"
              },
              {
                "conditions": [
                  {
                    "bundle_identifiers": [
                      "^com\\.parallels\\.desktop$",
                      "^com\\.parallels\\.vm$",
                      "^com\\.parallels\\.desktop\\.console$",
                      "^com\\.parallels\\.winapp\\."
                    ],
                    "type": "frontmost_application_if"
                  }
                ],
                "from": {
                  "key_code": "spacebar",
                  "modifiers": {
                    "mandatory": ["control"],
                    "optional": ["shift"]
                  }
                },
                "to": [
                  {
                    "key_code": "spacebar",
                    "modifiers": ["left_command"]
                  }
                ],
                "type": "basic"
              }
            ]
          }
        ]
      }
    }
  ]
}
